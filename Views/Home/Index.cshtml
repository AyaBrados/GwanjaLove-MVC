@{
    ViewData["Title"] = "Home";
}
@if (ViewBag.Specials.Count > 0)
{
	<h3 class="fst-italic m-2">Specials &nbsp;<i class="fa fa-tags"></i></h3>

	<div class="row horizontal-container">
	@foreach(ShopSpecial special in ViewBag.Specials)
	{
			<div class="col-md-4 col-sm-12 card horizontal-tile">
				<div class="col-12">
					<div class="col-8"><h4 class="card-header card-header-background">@special.Name</h4></div>
					<div class="col-4">@special.SpecialEndDate.ToLongDateString()</div>
				</div>
				<img class="card-img-top card-img-style" src="" entity-image="@special.Image" alt="@special.Name" />
				<div class="card-body bg-warning">
					<p class="card-text lead">
						@special.Description
					</p>
					<div class="row text-center">
						<button type="button" class="col-md-3 card-link site-primary-background" asp-action="Special" asp-controller="ShopSpecial" asp-route-id="@special.Id">
							more info
						</button>
						<button type="button" class="col-md-3 card-link site-primary-background" asp-action="Cart" asp-controller="Cart" asp-route-product="@special">
							Add to <i class="fa-cart-shopping"></i>
						</button>
						<div class="col-md-3">
							<span class="fw-bold">Price R</span>
							<span>@special.SpecialPrice.ToString("C")</span>
						</div>
					</div>
				</div>
			</div>
	}
	</div>
}


<div class="carousel slide carousel-fade carousel-dark carousel-container" id="homeCarousel" data-bs-ride="carousel" data-bs-interval="5000" data-pause="true" data-bs-wrap="true">
	<div class="carousel-indicators">
		<button type="button" class="active" aria-current="true" data-bs-target="homeCarousel" data-bs-slide-to="0" aria-label="Slide 1"></button>
		<button type="button" data-bs-target="homeCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
		<button type="button" data-bs-target="homeCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
	</div>
	<div class="carousel-inner">
		<div class="carousel-item">
			<img class="d-block w-100 carousel-image-size green-border" alt="sugar leaf" src="~/images/Sugar Leaf.jpg" />
			<div class="carousel-caption fw-bold">
				<h4 class="text-success">Sugar Leaf</h4>
				<p>These leaves are the closest to the bud and therefore they carry a lot of trichomes.</p>
			</div>
		</div>
		<div class="carousel-item active">
			<img class="d-block w-100 carousel-image-size green-border" alt="grand daddy purple" src="~/images/Granddaddy Purple Plant.jpg" />
			<div class="carousel-caption fw-bold">
				<h4 class="text-success">Grand Daddy Purple</h4>
				<p>This strain is both beautiful and powerful with it's vibrant purple colour.</p>
			</div>
		</div>
		<div class="carousel-item">
			<img class="d-block w-100 carousel-image-size green-border" alt="Deep Cheese" src="~/images/Deep Cheese.jpg" />
			<div class="carousel-caption fw-bold">
				<h4 class="text-success">Deep Cheese</h4>
				<p>Most cheese strains are exotic, nothing has changed with the new deep cheese variety.</p>
			</div>
		</div>
	</div>

	<button type="button" class="carousel-control-prev" data-bs-target="#homeCarousel" data-bs-slide="prev">
		<span class="carousel-control-prev-icon"></span>
		<span class="visually-hidden">Previous</span>
	</button>
	<button type="button" class="carousel-control-next" data-bs-target="#homeCarousel" data-bs-slide="next">
		<span class="carousel-control-next-icon"></span>
		<span class="visually-hidden">Next</span>
	</button>
</div>

<div class="row container-fluid">
	<div class="col-sm-12 col-md-6 green-border float-md-start card-height">
		<h3 class="text-center"><a asp-action="Products" asp-controller="Product" class="text-decoration-none">Products</a></h3>
        <div class="row">
			@foreach (Product product in ViewBag.Products)
			{
				<div class="card col-6 p-0 card-position card-background">
					<h4 class="card-header card-header-background">@product.Name</h4>
					<img class="card-img-top card-img-style" src="" entity-image="@product.Image" alt="@product.Name" />
					<div class="card-body bg-warning">
						<h5 class="card-title">Details of the @product.Category.Name</h5>
						<p class="card-text lead">
							@product.Description
						</p>
						<div class="text-center">
							<button type="button" class="card-link site-primary-background" asp-action="Products" asp-controller="Product">
								more info
							</button>
							<button type="button" class="card-link site-primary-background" asp-action="Cart" asp-controller="Cart" asp-route-product="@product">
								Add to <i class="fa-cart-shopping"></i>
							</button>
						</div>
					</div>
					<table class="card-footer table-borderless card-footer-style">
						<thead>
							<tr>
								@if (product.Category.Name.Equals("Smokeables") || product.Category.Name.Equals("Plant"))
								{
									<td>THC <i class="fa-regular fa-percentage"></i></td>
									if (product.Category.Name.Equals("Plant"))
									{
										<td class="px-md-2">Yield <i class="fa-brands fa-canadian-maple-leaf"></i></td>
									}
									<td class="px-md-2">Stickiness <i class="fa-solid fa-hands-asl-interpreting"></i></td>
									<td class="px-md-2">Flavour <i class="fa-solid fa-bong"></i></td>
									<td class="px-md-2">Aroma <i class="fa-solid fa-joint"></i></td>
								}
								else
								{

								}
								<td>Price R/g</td>
							</tr>
						</thead>
						<tbody>
							<tr>
								@if (product.Category.Name.Equals("Smokeables") || product.Category.Name.Equals("Plant"))
								{
									<td>@product.THCPerc?.ToString()</td>
									if (product.Category.Name.Equals("Plant"))
									{
										<td class="ps-md-2">@product.Yield</td>
									}
									<td class="ps-md-2">@product.StrainStickiness?.Description</td>
									<td class="px-md-2">@product.Flavour</td>
									<td class="px-md-2">@product.Aroma</td>
								}
								<td>@product.Price.ToString("C")</td>
							</tr>
						</tbody>
					</table>
				</div>
			}
        </div>
	</div>
	<div class="col-sm-12 col-md-6 green-border float-md-end card-height">
		<h3 class="text-center"><a asp-action="News" asp-controller="Home" class="text-decoration-none">News</a></h3>
		<div class="row">
			<div class="card col-10 card-position p-0 card-background">
				<img class="card-img-top card-img-style" src="~/images/GermanyLegalizes.png" alt="Light Purple tree inside!" />
				<div class="card-body bg-warning">
					<h5 class="card-title">Germany legalizes Marijuana</h5>
					<p class="card-text lead">
						A country with engineering excellence and a strong economy surely needs some alleviation/relief from hard work. What better way to
						achieve this through steaming a nice bud or two after a good day's work.
					</p>
					<div class="text-center">
						<a class="card-link btn site-primary-background" href="https://www.bbc.com/news/world-europe-68674813" target="_blank">
							more info
						</a>
					</div>
				</div>
			</div>
			<div class="card col-10 card-position p-0 card-background">
				<img class="card-img-top card-img-style" src="~/images/purpleBud.jpg" alt="Light Purple tree inside!" />
				<div class="card-body bg-warning">
					<h5 class="card-title">Germany legalizes Marijuana</h5>
					<p class="card-text lead">
						A country with engineering excellence and a strong economy surely needs some alleviation/relief from hard work. What better way to
						achieve this through steaming a nice bud or two after a good day's work.
					</p>
					<div class="text-center">
						<a class="card-link btn site-primary-background" href="https://www.bbc.com/news/world-europe-68674813" target="_blank">
							more info
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
